    "bullmq": "^5.7.0",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "sharp": "^0.35.3",
