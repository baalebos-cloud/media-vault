# Postgres
POSTGRES_PASSWORD=change-me

# MinIO / S3
MINIO_ROOT_USER=vault-admin
MINIO_ROOT_PASSWORD=change-me-too
S3_PUBLIC_ENDPOINT=https://storage.example.com

# Auth
JWT_SECRET=generate-a-long-random-string

# Email (verification + password reset) — reuses your existing
# baalebo.xyz Private Email mailbox
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=noreply@baalebo.xyz
SMTP_PASS=your-mailbox-password
EMAIL_FROM="Media Vault <noreply@baalebo.xyz>"

# Used to build links inside verification/reset emails
FRONTEND_URL=http://localhost:3000

# Public URLs (behind Cloudflare Tunnel)
PUBLIC_API_URL=https://api.example.com

# Cloudflare Tunnel (create via `cloudflared tunnel create vault` then `cloudflared tunnel token vault`)
CLOUDFLARE_TUNNEL_TOKEN=
